        ACONFIG["config/"]
        AROUTES["routes/"]
        ACTRL["controllers/"]
        AMID["middleware/"]
        ASVC["services/"]
        ATYPES["types/"]
        AUTILS["utils/"]
    end

    subgraph APRISMA["apps/api/prisma"]
        APSCHEMA["schema.prisma (PostgreSQL datasource)"]
        AMIG["migrations/"]
    end

    subgraph DOCS["docs/"]
        D1["architecture/ · api/ · deployment/"]
        D2["decisions/ (ADRs) · specifications/"]
        D3["testing/ · audit/ · diagrams/"]
    end

    subgraph DIAGRAMS["diagrams/"]
        DG1["9 Mermaid diagrams (.mmd)"]
    end

    subgraph ASSETS["assets/"]
        AS1["branding/ · icons/ · images/ · screenshots/"]
    end

    subgraph SCRIPTS["scripts/"]
        SC1["dev-api.sh · dev-mobile.sh · check.sh"]
    end

    subgraph PACKAGES["packages/"]
        PK1["shared packages (README.md)"]
    end

    subgraph TESTS["tests/"]
        T1["top-level test utilities (README.md)"]
    end

    subgraph GH["github/ — .github"]
        GH1["workflows/ci.yml (backend + mobile + docker jobs)"]
        GH2["dependabot.yml · ISSUE_TEMPLATE/"]
    end

