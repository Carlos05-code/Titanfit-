        MOBILE["apps/mobile — Flutter app"]
        API["apps/api — Node/TS/Express/Prisma"]
    end

    subgraph MLIB["apps/mobile/lib"]
        MCORE["core/ — router · network · theme · services · widgets"]
        MDATA["data/ — models · repositories"]
